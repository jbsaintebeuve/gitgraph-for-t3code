# Linux verification image: `scripts/test-linux.sh` builds it for ubuntu:22.04 (git 2.34) and 24.04.
ARG BASE=ubuntu:22.04
FROM node:22-bookworm-slim AS node
FROM ${BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
# Node 22 binary + npm from the official image (same result as NodeSource for our purposes).
COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx
# Non-root user, like a real desktop session.
RUN useradd -m dev
USER dev
WORKDIR /home/dev/gitgraph
COPY --chown=dev:dev . .
COPY --chown=dev:dev scripts/container-check.sh /home/dev/container-check.sh
CMD ["bash", "/home/dev/container-check.sh"]
